  <script>
    const html = document.documentElement;
    const themeToggle = document.getElementById("themeToggle");
    const collapseToggle = document.getElementById("collapseToggle");
    const sections = Array.from(document.querySelectorAll(".section"));

    function updateThemeIcon() {
      themeToggle.textContent = html.classList.contains("light") ? "☀" : "☾";
    }

    themeToggle.addEventListener("click", () => {
      html.classList.toggle("light");
      try {
        localStorage.setItem("theme", html.classList.contains("light") ? "light" : "dark");
      } catch (e) {}
      updateThemeIcon();
    });

    sections.forEach((section) => {
      const button = section.querySelector(".section-toggle");
      button.addEventListener("click", () => {
        section.classList.toggle("closed");
        updateCollapseIcon();
      });
    });

    function updateCollapseIcon() {
      const allClosed = sections.every(section => section.classList.contains("closed"));
      collapseToggle.textContent = allClosed ? "+" : "−";
    }

    collapseToggle.addEventListener("click", () => {
      const allClosed = sections.every(section => section.classList.contains("closed"));
      sections.forEach(section => section.classList.toggle("closed", !allClosed));
      updateCollapseIcon();
    });

    document.getElementById("year").textContent = new Date().getFullYear();
    updateThemeIcon();
    updateCollapseIcon();
  </script>
